{
  "name": "vintasend",
  "version": "1.0.0-alpha8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/vintasend-ts.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./local-file-attachment-manager": {
      "types": "./dist/local-file-attachment-manager.d.ts",
      "import": "./dist/local-file-attachment-manager.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.16"
  },
  "author": "Hugo Bessa",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check --write .",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "implementation:generate": "node scripts/generate-implementation.js",
    "lint:implementations": "node scripts/run-implementations-script.js lint",
    "format:implementations": "node scripts/run-implementations-script.js format",
    "test:implementations:local": "node scripts/test-implementations-local.js",
    "check:local": "node scripts/check-all-local.js",
    "check:local:fix": "node scripts/check-all-local.js --fix",
    "build:implementations:local": "node scripts/test-implementations-local.js --command=build",
    "release:prepare": "npm run format && npm test && npm run format:implementations && npm run test:implementations:local && npm run build:implementations:local",
    "release:bump": "node scripts/release-bump.js",
    "release:bump:patch": "node scripts/release-bump.js --bump=patch",
    "release:bump:minor": "node scripts/release-bump.js --bump=minor",
    "release:bump:major": "node scripts/release-bump.js --bump=major",
    "release:bump:alpha": "node scripts/release-bump.js --bump=alpha",
    "release:bump:alpha:major": "node scripts/release-bump.js --bump=alpha --alpha-base=major",
    "release:bump:promote": "node scripts/release-bump.js --bump=promote",
    "release:publish": "node scripts/release-publish.js",
    "release:tag": "node scripts/release-tag.js",
    "release:tag:dry": "node scripts/release-tag.js --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "mime": "^4.1.2"
  }
}
